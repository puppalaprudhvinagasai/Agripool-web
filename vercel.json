{
  "version": 2,
  "framework": null,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/farmer/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|css/|js/|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}
