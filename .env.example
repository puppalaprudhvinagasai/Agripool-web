# ==============================================================================
# AGRI POOL — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
JWT_SECRET=agripool_super_secret_jwt_key_change_in_production_2026

# ==============================================================================
# 3. SUPABASE CONFIGURATION
# Connect to your Supabase Project (Project Settings -> API)
# ==============================================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ==============================================================================
# 4. SMTP / EMAIL CONFIGURATION
# Used for Email Verification, Password Reset, and Account Notifications
# Can use Gmail, SendGrid, Resend, Amazon SES, or Supabase SMTP
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM="AgriPool Platform" <your_email@gmail.com>

# ==============================================================================
# 5. LIVE MARKET COMMODITY APMC MANDI API (data.gov.in)
# ==============================================================================
LIVE_MARKET_API_KEY=your_live_market_api_key_here
AGMARKNET_API_KEY=your_agmarknet_api_key_here

